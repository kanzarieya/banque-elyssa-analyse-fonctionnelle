<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_BanqueElyssa"
                  targetNamespace="http://banque-elyssa.example/bpmn">
  <bpmn:collaboration id="Collaboration_ASIS">
    <bpmn:participant id="Participant_BanqueElyssa" name="Banque Elyssa — Demande de crédit (AS-IS)" processRef="Process_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ASIS" name="Demande de crédit — processus actuel" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ASIS">
      <bpmn:lane id="Lane_Client" name="Client">
        <bpmn:flowNodeRef>StartEvent_Client</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClientDepot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClientRecoit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Accord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Refus</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agence" name="Agence — accueil">
        <bpmn:flowNodeRef>Task_AccueilVerifie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Complet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AccueilDemande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AccueilFiche</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AccueilTransmet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Siege" name="Siège — étude crédit">
        <bpmn:flowNodeRef>Task_SiegeRecoit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Conforme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SiegeRelance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SiegeSaisie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SiegeArchive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comite" name="Comité de crédit">
        <bpmn:flowNodeRef>Task_ComiteExamine</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Client" name="Demande de crédit" />
    <bpmn:task id="Task_ClientDepot" name="Déposer la demande et les pièces à l'agence" />
    <bpmn:task id="Task_ClientRecoit" name="Recevoir la réponse (téléphone ou courrier)" />
    <bpmn:exclusiveGateway id="Gateway_Issue" name="Décision ?" />
    <bpmn:endEvent id="EndEvent_Accord" name="Crédit accordé — signature en agence" />
    <bpmn:endEvent id="EndEvent_Refus" name="Crédit refusé" />

    <bpmn:task id="Task_AccueilVerifie" name="Vérifier les pièces (liste papier)" />
    <bpmn:exclusiveGateway id="Gateway_Complet" name="Pièces complètes ?" />
    <bpmn:task id="Task_AccueilDemande" name="Demander les pièces manquantes au client" />
    <bpmn:task id="Task_AccueilFiche" name="Remplir la fiche papier de demande" />
    <bpmn:task id="Task_AccueilTransmet" name="Scanner et transmettre le dossier au siège" />

    <bpmn:task id="Task_SiegeRecoit" name="Réceptionner et contrôler la complétude" />
    <bpmn:exclusiveGateway id="Gateway_Conforme" name="Dossier conforme ?" />
    <bpmn:task id="Task_SiegeRelance" name="Relancer l'agence par téléphone" />
    <bpmn:task id="Task_SiegeSaisie" name="Saisir dans le fichier Excel partagé" />
    <bpmn:task id="Task_SiegeArchive" name="Rechercher l'historique client (archives papier)" />

    <bpmn:task id="Task_ComiteExamine" name="Examiner le dossier en réunion hebdomadaire" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Client" targetRef="Task_ClientDepot" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ClientDepot" targetRef="Task_AccueilVerifie" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_AccueilVerifie" targetRef="Gateway_Complet" />
    <bpmn:sequenceFlow id="Flow_04" name="Non" sourceRef="Gateway_Complet" targetRef="Task_AccueilDemande" />
    <bpmn:sequenceFlow id="Flow_05" name="Le client revient plus tard" sourceRef="Task_AccueilDemande" targetRef="Task_ClientDepot" />
    <bpmn:sequenceFlow id="Flow_06" name="Oui" sourceRef="Gateway_Complet" targetRef="Task_AccueilFiche" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_AccueilFiche" targetRef="Task_AccueilTransmet" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_AccueilTransmet" targetRef="Task_SiegeRecoit" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SiegeRecoit" targetRef="Gateway_Conforme" />
    <bpmn:sequenceFlow id="Flow_10" name="Non" sourceRef="Gateway_Conforme" targetRef="Task_SiegeRelance" />
    <bpmn:sequenceFlow id="Flow_11" name="Après correction (2 à 5 jours)" sourceRef="Task_SiegeRelance" targetRef="Task_SiegeRecoit" />
    <bpmn:sequenceFlow id="Flow_12" name="Oui" sourceRef="Gateway_Conforme" targetRef="Task_SiegeSaisie" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SiegeSaisie" targetRef="Task_SiegeArchive" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SiegeArchive" targetRef="Task_ComiteExamine" />
    <bpmn:sequenceFlow id="Flow_15" name="Décision communiquée par courrier ou téléphone" sourceRef="Task_ComiteExamine" targetRef="Task_ClientRecoit" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ClientRecoit" targetRef="Gateway_Issue" />
    <bpmn:sequenceFlow id="Flow_17" name="Accord" sourceRef="Gateway_Issue" targetRef="EndEvent_Accord" />
    <bpmn:sequenceFlow id="Flow_18" name="Refus" sourceRef="Gateway_Issue" targetRef="EndEvent_Refus" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ASIS">
    <bpmndi:BPMNPlane id="BPMNPlane_ASIS" bpmnElement="Collaboration_ASIS">
      <bpmndi:BPMNShape id="Participant_BanqueElyssa_di" bpmnElement="Participant_BanqueElyssa" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1460" height="620" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Client_di" bpmnElement="Lane_Client" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1430" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agence_di" bpmnElement="Lane_Agence" isHorizontal="true">
        <dc:Bounds x="190" y="240" width="1430" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Siege_di" bpmnElement="Lane_Siege" isHorizontal="true">
        <dc:Bounds x="190" y="390" width="1430" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Comite_di" bpmnElement="Lane_Comite" isHorizontal="true">
        <dc:Bounds x="190" y="580" width="1430" height="120" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Client_di" bpmnElement="StartEvent_Client">
        <dc:Bounds x="200" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="180" y="185" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClientDepot_di" bpmnElement="Task_ClientDepot">
        <dc:Bounds x="270" y="130" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClientRecoit_di" bpmnElement="Task_ClientRecoit">
        <dc:Bounds x="1060" y="130" width="130" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Issue_di" bpmnElement="Gateway_Issue" isMarkerVisible="true">
        <dc:Bounds x="1215" y="140" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Accord_di" bpmnElement="EndEvent_Accord">
        <dc:Bounds x="1300" y="190" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Refus_di" bpmnElement="EndEvent_Refus">
        <dc:Bounds x="1300" y="104" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AccueilVerifie_di" bpmnElement="Task_AccueilVerifie">
        <dc:Bounds x="400" y="285" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Complet_di" bpmnElement="Gateway_Complet" isMarkerVisible="true">
        <dc:Bounds x="550" y="295" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AccueilDemande_di" bpmnElement="Task_AccueilDemande">
        <dc:Bounds x="620" y="285" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AccueilFiche_di" bpmnElement="Task_AccueilFiche">
        <dc:Bounds x="800" y="285" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AccueilTransmet_di" bpmnElement="Task_AccueilTransmet">
        <dc:Bounds x="950" y="285" width="140" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SiegeRecoit_di" bpmnElement="Task_SiegeRecoit">
        <dc:Bounds x="950" y="455" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Conforme_di" bpmnElement="Gateway_Conforme" isMarkerVisible="true">
        <dc:Bounds x="1130" y="465" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SiegeSaisie_di" bpmnElement="Task_SiegeSaisie">
        <dc:Bounds x="1200" y="455" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SiegeArchive_di" bpmnElement="Task_SiegeArchive">
        <dc:Bounds x="1370" y="455" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SiegeRelance_di" bpmnElement="Task_SiegeRelance">
        <dc:Bounds x="1200" y="520" width="150" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ComiteExamine_di" bpmnElement="Task_ComiteExamine">
        <dc:Bounds x="1360" y="610" width="150" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="236" y="160" />
        <di:waypoint x="270" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="330" y="190" />
        <di:waypoint x="460" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="520" y="315" />
        <di:waypoint x="550" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="590" y="315" />
        <di:waypoint x="620" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="690" y="285" />
        <di:waypoint x="690" y="215" />
        <di:waypoint x="350" y="215" />
        <di:waypoint x="350" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="570" y="295" />
        <di:waypoint x="570" y="265" />
        <di:waypoint x="860" y="265" />
        <di:waypoint x="860" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="920" y="315" />
        <di:waypoint x="950" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="1020" y="345" />
        <di:waypoint x="1025" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="1100" y="485" />
        <di:waypoint x="1130" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1150" y="505" />
        <di:waypoint x="1275" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1200" y="545" />
        <di:waypoint x="1025" y="545" />
        <di:waypoint x="1025" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1170" y="485" />
        <di:waypoint x="1200" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1340" y="485" />
        <di:waypoint x="1370" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1445" y="515" />
        <di:waypoint x="1435" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="1360" y="640" />
        <di:waypoint x="1125" y="640" />
        <di:waypoint x="1125" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="1190" y="160" />
        <di:waypoint x="1215" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="1255" y="170" />
        <di:waypoint x="1300" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18">
        <di:waypoint x="1255" y="150" />
        <di:waypoint x="1300" y="122" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_BanqueElyssa_TOBE"
                  targetNamespace="http://banque-elyssa.example/bpmn">
  <bpmn:collaboration id="Collaboration_TOBE">
    <bpmn:participant id="Participant_BanqueElyssa_TOBE" name="Banque Elyssa — Demande de crédit (TO-BE)" processRef="Process_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TOBE" name="Demande de crédit — processus cible" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TOBE">
      <bpmn:lane id="Lane_Client" name="Client">
        <bpmn:flowNodeRef>StartEvent_Client</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Canal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClientDepotWeb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClientComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Accord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Refus</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agence" name="Agence — accueil">
        <bpmn:flowNodeRef>Task_AgenceDepot</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Système — portail crédit">
        <bpmn:flowNodeRef>Task_SysCreerDossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SysControle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Completude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SysNotifierInstruction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SysManquants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SysTransmettreComite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SysNotifierDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Siege" name="Siège — étude crédit">
        <bpmn:flowNodeRef>Task_AnalysteInstruction</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comite" name="Comité de crédit">
        <bpmn:flowNodeRef>Task_ComiteDecide</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Client" name="Demande de crédit" />
    <bpmn:exclusiveGateway id="Gateway_Canal" name="Canal de dépôt ?" />
    <bpmn:task id="Task_ClientDepotWeb" name="Déposer la demande sur le portail (web/mobile)" />
    <bpmn:task id="Task_ClientComplete" name="Compléter les pièces manquantes (re-dépôt)" />
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Décision ?" />
    <bpmn:endEvent id="EndEvent_Accord" name="Crédit accordé — signature planifiée en agence" />
    <bpmn:endEvent id="EndEvent_Refus" name="Refus notifié avec motif" />

    <bpmn:task id="Task_AgenceDepot" name="Saisir la demande avec le client (formulaire unique)" />

    <bpmn:serviceTask id="Task_SysCreerDossier" name="Créer le dossier unique + récépissé + notification" />
    <bpmn:serviceTask id="Task_SysControle" name="Contrôler la complétude (référentiel paramétré)" />
    <bpmn:exclusiveGateway id="Gateway_Completude" name="Dossier complet ?" />
    <bpmn:serviceTask id="Task_SysNotifierInstruction" name="Notifier le client : dossier en instruction" />
    <bpmn:serviceTask id="Task_SysManquants" name="Lister les pièces manquantes + notifier" />
    <bpmn:serviceTask id="Task_SysTransmettreComite" name="Transmettre au comité (dossier + avis + historique)" />
    <bpmn:serviceTask id="Task_SysNotifierDecision" name="Notifier la décision + prochaines étapes" />

    <bpmn:task id="Task_AnalysteInstruction" name="Instruire le dossier (historique intégré)" />
    <bpmn:task id="Task_ComiteDecide" name="Décider (processus inchangé)" />

    <bpmn:sequenceFlow id="Flow_T01" sourceRef="StartEvent_Client" targetRef="Gateway_Canal" />
    <bpmn:sequenceFlow id="Flow_T02" name="En ligne" sourceRef="Gateway_Canal" targetRef="Task_ClientDepotWeb" />
    <bpmn:sequenceFlow id="Flow_T03" name="En agence" sourceRef="Gateway_Canal" targetRef="Task_AgenceDepot" />
    <bpmn:sequenceFlow id="Flow_T04" sourceRef="Task_ClientDepotWeb" targetRef="Task_SysCreerDossier" />
    <bpmn:sequenceFlow id="Flow_T05" sourceRef="Task_AgenceDepot" targetRef="Task_SysCreerDossier" />
    <bpmn:sequenceFlow id="Flow_T06" sourceRef="Task_SysCreerDossier" targetRef="Task_SysControle" />
    <bpmn:sequenceFlow id="Flow_T07" sourceRef="Task_SysControle" targetRef="Gateway_Completude" />
    <bpmn:sequenceFlow id="Flow_T08" name="Oui" sourceRef="Gateway_Completude" targetRef="Task_SysNotifierInstruction" />
    <bpmn:sequenceFlow id="Flow_T09" sourceRef="Task_SysNotifierInstruction" targetRef="Task_AnalysteInstruction" />
    <bpmn:sequenceFlow id="Flow_T10" name="Non" sourceRef="Gateway_Completude" targetRef="Task_SysManquants" />
    <bpmn:sequenceFlow id="Flow_T11" sourceRef="Task_SysManquants" targetRef="Task_ClientComplete" />
    <bpmn:sequenceFlow id="Flow_T12" name="Re-contrôle automatique" sourceRef="Task_ClientComplete" targetRef="Task_SysControle" />
    <bpmn:sequenceFlow id="Flow_T13" sourceRef="Task_AnalysteInstruction" targetRef="Task_SysTransmettreComite" />
    <bpmn:sequenceFlow id="Flow_T14" sourceRef="Task_SysTransmettreComite" targetRef="Task_ComiteDecide" />
    <bpmn:sequenceFlow id="Flow_T15" sourceRef="Task_ComiteDecide" targetRef="Task_SysNotifierDecision" />
    <bpmn:sequenceFlow id="Flow_T16" sourceRef="Task_SysNotifierDecision" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_T17" name="Accord" sourceRef="Gateway_Decision" targetRef="EndEvent_Accord" />
    <bpmn:sequenceFlow id="Flow_T18" name="Refus" sourceRef="Gateway_Decision" targetRef="EndEvent_Refus" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_TOBE">
    <bpmndi:BPMNPlane id="BPMNPlane_TOBE" bpmnElement="Collaboration_TOBE">
      <bpmndi:BPMNShape id="Participant_BanqueElyssa_TOBE_di" bpmnElement="Participant_BanqueElyssa_TOBE" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1500" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Client_di" bpmnElement="Lane_Client" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agence_di" bpmnElement="Lane_Agence" isHorizontal="true">
        <dc:Bounds x="190" y="210" width="1470" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="1470" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Siege_di" bpmnElement="Lane_Siege" isHorizontal="true">
        <dc:Bounds x="190" y="490" width="1470" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Comite_di" bpmnElement="Lane_Comite" isHorizontal="true">
        <dc:Bounds x="190" y="610" width="1470" height="110" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Client_di" bpmnElement="StartEvent_Client">
        <dc:Bounds x="200" y="127" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Canal_di" bpmnElement="Gateway_Canal" isMarkerVisible="true">
        <dc:Bounds x="270" y="125" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClientDepotWeb_di" bpmnElement="Task_ClientDepotWeb">
        <dc:Bounds x="350" y="115" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClientComplete_di" bpmnElement="Task_ClientComplete">
        <dc:Bounds x="1150" y="115" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="1350" y="125" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Accord_di" bpmnElement="EndEvent_Accord">
        <dc:Bounds x="1440" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Refus_di" bpmnElement="EndEvent_Refus">
        <dc:Bounds x="1440" y="168" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AgenceDepot_di" bpmnElement="Task_AgenceDepot">
        <dc:Bounds x="350" y="235" width="150" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SysCreerDossier_di" bpmnElement="Task_SysCreerDossier">
        <dc:Bounds x="350" y="375" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SysControle_di" bpmnElement="Task_SysControle">
        <dc:Bounds x="530" y="375" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Completude_di" bpmnElement="Gateway_Completude" isMarkerVisible="true">
        <dc:Bounds x="700" y="385" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SysNotifierInstruction_di" bpmnElement="Task_SysNotifierInstruction">
        <dc:Bounds x="790" y="375" width="170" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SysManquants_di" bpmnElement="Task_SysManquants">
        <dc:Bounds x="790" y="435" width="170" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SysTransmettreComite_di" bpmnElement="Task_SysTransmettreComite">
        <dc:Bounds x="1000" y="375" width="180" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SysNotifierDecision_di" bpmnElement="Task_SysNotifierDecision">
        <dc:Bounds x="1250" y="375" width="170" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AnalysteInstruction_di" bpmnElement="Task_AnalysteInstruction">
        <dc:Bounds x="790" y="520" width="170" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ComiteDecide_di" bpmnElement="Task_ComiteDecide">
        <dc:Bounds x="1090" y="640" width="170" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_T01_di" bpmnElement="Flow_T01">
        <di:waypoint x="236" y="145" />
        <di:waypoint x="270" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T02_di" bpmnElement="Flow_T02">
        <di:waypoint x="310" y="145" />
        <di:waypoint x="350" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T03_di" bpmnElement="Flow_T03">
        <di:waypoint x="290" y="165" />
        <di:waypoint x="290" y="265" />
        <di:waypoint x="350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T04_di" bpmnElement="Flow_T04">
        <di:waypoint x="425" y="175" />
        <di:waypoint x="425" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T05_di" bpmnElement="Flow_T05">
        <di:waypoint x="425" y="295" />
        <di:waypoint x="425" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T06_di" bpmnElement="Flow_T06">
        <di:waypoint x="500" y="405" />
        <di:waypoint x="530" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T07_di" bpmnElement="Flow_T07">
        <di:waypoint x="670" y="405" />
        <di:waypoint x="700" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T08_di" bpmnElement="Flow_T08">
        <di:waypoint x="740" y="405" />
        <di:waypoint x="790" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T09_di" bpmnElement="Flow_T09">
        <di:waypoint x="875" y="435" />
        <di:waypoint x="875" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T10_di" bpmnElement="Flow_T10">
        <di:waypoint x="720" y="425" />
        <di:waypoint x="720" y="460" />
        <di:waypoint x="790" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T11_di" bpmnElement="Flow_T11">
        <di:waypoint x="960" y="460" />
        <di:waypoint x="1225" y="460" />
        <di:waypoint x="1225" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T12_di" bpmnElement="Flow_T12">
        <di:waypoint x="1150" y="145" />
        <di:waypoint x="1110" y="145" />
        <di:waypoint x="1110" y="290" />
        <di:waypoint x="600" y="290" />
        <di:waypoint x="600" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T13_di" bpmnElement="Flow_T13">
        <di:waypoint x="960" y="550" />
        <di:waypoint x="1090" y="550" />
        <di:waypoint x="1090" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T14_di" bpmnElement="Flow_T14">
        <di:waypoint x="1090" y="435" />
        <di:waypoint x="1090" y="670" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T15_di" bpmnElement="Flow_T15">
        <di:waypoint x="1260" y="670" />
        <di:waypoint x="1335" y="670" />
        <di:waypoint x="1335" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T16_di" bpmnElement="Flow_T16">
        <di:waypoint x="1335" y="375" />
        <di:waypoint x="1335" y="145" />
        <di:waypoint x="1350" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T17_di" bpmnElement="Flow_T17">
        <di:waypoint x="1390" y="135" />
        <di:waypoint x="1440" y="128" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T18_di" bpmnElement="Flow_T18">
        <di:waypoint x="1390" y="155" />
        <di:waypoint x="1440" y="186" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
